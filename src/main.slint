// 全局与类型再导出：Rust 侧经 include_modules 访问（ui.global::<TransportState>() 等）。
export { TransportState, PlaylistState, AboutState, DockState, EqState } from "state.slint";
export { PlaylistEntry, UpdateState } from "state.slint";
// 独立播放列表窗口（阶段 C）：Rust 侧按需实例化/销毁。
export { PlaylistWindow } from "playlist_window.slint";
import { TransportState, PlaylistState, AboutState, UpdateState, DockState, EqState } from "state.slint";
import { IconButton, VolumeBar } from "widgets.slint";
import { PlaylistDrawer } from "playlist.slint";
import { AboutCard } from "about.slint";
import { EqPanel } from "eq.slint";
// zzhMusicPlayer 主界面：无边框、亚克力毛玻璃 + 主题渐变背景。
// 布局：左侧专辑封面（无封面时隐藏）+ 歌曲/艺术家两行信息、右上角窗口控制；
// 中部圆润镜像波形进度条（视觉核心，已播主题色 / 未播半透明白）；
// 底部时间标签 + 半透明控制胶囊（模式/上一曲/播放暂停/下一曲/音量/播放列表）；
// 底部滑出播放列表抽屉。

// 播放列表行数据：name 是显示名，real 是在完整播放列表中的真实索引
// （搜索过滤后显示行号与真实索引不一致，高亮当前曲目用 real 比较）。
// 更新流程状态机：idle 未检查 → checking → latest/failed，
// available（发现新版，未下载）→ downloading → ready。



// 圆形图标按钮：透明玻璃底 + 发丝描边，悬停轻微提亮、按下缩小回弹。

// 播放/暂停按钮：两个图标 150ms 透明度交叉淡入淡出。
component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <length> button-size: 36px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: button-size / 2;
    border-width: 1px;
    // 主题色调玻璃底 + 柔和主题色描边：主按钮在透明玻璃按钮中保持视觉分量。
    border-color: TransportState.theme-color.with-alpha(0.40);
    background: TransportState.theme-color.with-alpha(ta.has-hover ? 0.38 : 0.22);
    transform-scale: ta.pressed ? 0.90 : (ta.has-hover ? 1.08 : 1.0);
    animate transform-scale { duration: 100ms; easing: ease-out; }
    animate background { duration: 120ms; easing: ease-out; }

    Image {
        source: @image-url("../icons/播放中.svg");
        x: (button-size - button-size * 0.56) / 2;
        y: (button-size - button-size * 0.56) / 2;
        width: button-size * 0.56;
        height: button-size * 0.56;
        image-fit: contain;
        image-rendering: smooth;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.playing ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }
    }
    Image {
        source: @image-url("../icons/暂停.svg");
        x: (button-size - button-size * 0.56) / 2;
        y: (button-size - button-size * 0.56) / 2;
        width: button-size * 0.56;
        height: button-size * 0.56;
        image-fit: contain;
        image-rendering: smooth;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.playing ? 0.0 : 1.0;
        animate opacity { duration: 150ms; }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// 横向音量条：细轨道 + 主题色填充 + 白色滑块圆点。

// 播放列表行：手柄 + 曲名 + 当前曲目迷你均衡器 + 文件夹/移除按钮。
// 点击播放与拖动排序由窗口级的列表左区覆盖层统一处理（见 MainWindow），
// 行内不铺 TouchArea，避免与 Flickable 的滚动手势冲突。
// index 是过滤后显示模型的行号（悬停/重排用），real 是完整列表中的真实索引。

// 波形进度区：圆润镜像波形条（已播主题色 / 未播半透明白）
// + 进度竖线光晕 + 拖尾粒子 + 悬停位置指示线。
component WaveformArea inherits Rectangle {
    in property <float> progress-frac;

    background: transparent;

    property <int> bar-count: TransportState.wave-bars.length;
    property <length> step: bar-count > 0 ? self.width / bar-count : 0px;
    property <length> bar-w: step * 0.62;

    // 无曲目占位：中心细线 + 操作提示。
    Rectangle {
        visible: root.bar-count == 0;
        x: 0px;
        y: root.height / 2 - 1px;
        width: 100%;
        height: 2px;
        border-radius: 1px;
        background: #ffffff14;
    }
    Text {
        visible: root.bar-count == 0;
        y: root.height / 2 + 8px;
        width: 100%;
        height: 14px;
        text: "双击窗口或拖入音频文件开始播放";
        font-size: 10px;
        color: #ffffff38;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 波形条：居中镜像，高度来自真实 PCM 峰值；换曲时整排平滑过渡。
    for b[i] in TransportState.wave-bars: Rectangle {
        x: i * root.step + (root.step - root.bar-w) / 2;
        y: (root.height - self.height) / 2;
        width: root.bar-w;
        height: max(root.height * b, 3px);
        border-radius: self.width / 2;
        background: ((i + 0.5) * root.step) < root.width * root.progress-frac
            ? TransportState.theme-color
            : #ffffff2e;
        animate height { duration: 280ms; easing: ease-out; }
    }

    // 播放头：一根全高白色圆角条随进度连续平移（高度与波形包络最高点对齐）。
    Rectangle {
        visible: root.bar-count > 0;
        x: max(root.width * root.progress-frac - self.width / 2, 0px);
        y: 0px;
        width: max(root.bar-w, 3px);
        height: 100%;
        border-radius: self.width / 2;
        background: #f5f7fa;
    }

    // 播放头光晕（径向渐变，中心亮、向外透明；作用在播放头条上）。
    Rectangle {
        x: max(root.width * root.progress-frac - 24px, 0px);
        y: root.height / 2 - 24px;
        width: 48px;
        height: 48px;
        background: @radial-gradient(
            circle,
            TransportState.theme-color.with-alpha(0.34) 0%,
            TransportState.theme-color.with-alpha(0.10) 45%,
            transparent 100%
        );
    }

    // 持续生成的白色粒子：在进度竖线处随机散布出现，各自以不同速度
    // 向左后方飘散、随年龄缩小并逐渐消失（伪随机取模确定外观，非正弦排布）。
    for p[i] in [0.0, 0.23, 0.11, 0.47, 0.05, 0.62, 0.34, 0.81]: Rectangle {
        property <float> age: mod(TransportState.particle-time + p, 1.0);
        // 随机散布高度：伪随机取模，范围约 ±22% 波形高度。
        property <length> yoff: ((mod(i * 31, 7) * 2 + mod(i * 17, 5) - 8) * parent.height) / 34;
        // 随机横向飘散速度（68 / 88 / 108 像素每周期）。
        property <length> speed: 68px + mod(i, 3) * 20px;
        x: max(root.width * root.progress-frac - age * speed, 0px);
        // 主高度随机 + 微小幅值抖动（0.05），不形成正弦形状。
        y: max(root.height / 2 + yoff + sin(age * 360deg + i * 77deg) * parent.height * 0.05 - 1.5px, 0px);
        width: max(2px, 3px - age * (1px + mod(i, 2) * 1px));
        height: max(2px, 3px - age * (1px + mod(i, 2) * 1px));
        border-radius: 1.5px;
        background: #ffffff;
        opacity: TransportState.playing ? pow(1.0 - age, 1.4 + mod(i, 3) * 0.4) : 0.0;
        // 此处绝不能加 animate opacity：泵每 33ms 更新一次 opacity，每次
        // 都会重启一个 200ms 动画，动画时钟永不空闲，Slint 会以显示器
        // 刷新率（240Hz 屏实测 237fps）持续整窗重绘，空闲烧 40% CPU。
        // 粒子的年龄曲线本身已经是逐帧渐隐，无需补间。
    }

    // 悬停位置上报（Rust 侧 33ms 计时器读取并格式化时间提示，仅变化时写入）。
    property <float> hover-frac: ta.has-hover ? clamp(ta.mouse-x / root.width, 0.0, 1.0) : -1.0;
    changed hover-frac => { TransportState.wave-hover-frac = self.hover-frac; }

    // 悬停指示线（鼠标在波形区移动时预览落点）。
    Rectangle {
        visible: ta.has-hover;
        x: clamp(ta.mouse-x - 0.5px, 0px, root.width - 1px);
        y: root.height * 0.14;
        width: 1px;
        height: root.height * 0.72;
        background: #ffffff59;
    }

    // 悬停时间提示：深色玻璃底 + 一层主题色调（随换曲过渡），醒目不刺眼。
    Rectangle {
        visible: ta.has-hover && TransportState.tooltip-text != "";
        x: clamp(ta.mouse-x - self.width / 2, 2px, root.width - self.width - 2px);
        y: -30px;
        width: tip-text.preferred-width + 20px;
        height: 22px;
        border-radius: 11px;
        background: #131823f0;
        border-width: 1px;
        border-color: TransportState.theme-color.with-alpha(0.45);
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000066;

        // 主题色调叠加层（淡）。
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            border-radius: 11px;
            background: TransportState.theme-color;
            opacity: 0.28;
        }

        tip-text := Text {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            text: TransportState.tooltip-text;
            font-size: 11px;
            font-weight: 500;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 点击/拖拽跳转（按下后 Slint 捕获指针，mouse-x 持续跟随）。
    ta := TouchArea {
        property <float> preview: min(max(self.mouse-x / root.width, 0.0), 1.0);
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                TransportState.dragging = true;
                TransportState.drag-fraction = preview;
            } else if e.kind == PointerEventKind.move {
                if TransportState.dragging {
                    TransportState.drag-fraction = preview;
                }
            } else if e.kind == PointerEventKind.up {
                if TransportState.dragging {
                    TransportState.drag-fraction = preview;
                    // 先同步提交目标位置，再结束 dragging，避免中间一帧回到旧进度。
                    TransportState.seek-requested(preview);
                    TransportState.dragging = false;
                }
            }
        }
        mouse-cursor: pointer;
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "zzhMusicPlayer";
    width: 720px;
    // 停靠区开合平滑（幕布式）：动画驱动源是 dock-h 镜像，而非直接动画 height。
    // 窗口高度 = 178 + dock-h、主控条 y = height - 46 - dock-h——两式共用同一
    // 动画值，差值在逐帧动画期间数学恒定，主控条纹丝不动、无布局瞬态；
    // 停靠容器 y = height - dock-h 同样恒定，内容锚定顶部被 clip 逐帧揭开。
    // 亚克力背板随窗口逐帧生长，不再整窗瞬跳/闪烁。
    property <length> dock-h: DockState.open ? DockState.module-height : 0px;
    animate dock-h { duration: 240ms; easing: ease-out; }
    height: 178px + dock-h;
    default-font-family: "HarmonyOS Sans SC";

    // 全局快捷键：空格 播放/暂停，左右方向键 快退/快进 5 秒，
    // Esc 关闭搜索框（搜索输入框聚焦时按键会冒泡到这里）。
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        KeyBinding {
            keys: @keys(Space);
            activated => { TransportState.toggle-play(); }
        }
        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { TransportState.seek-relative(-5.0); }
        }
        KeyBinding {
            keys: @keys(RightArrow);
            activated => { TransportState.seek-relative(5.0); }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (PlaylistState.search-open) { pl-drawer.collapse-search(); }
            }
        }
    }

    // 收起搜索框：清空过滤、隐藏搜索框并把焦点交还全局快捷键。
    // 供 Esc / 图标 / 列表点击 / 关闭抽屉等多处复用。
    function collapse-search() {
        PlaylistState.search-open = false;
        PlaylistState.search-text = "";
        PlaylistState.search-edited("");
        shortcuts.focus();
    }

    // 播放位置比例：播放引擎每 ~50ms 上报一次，直接步进。
    // 此处绝不能加 200ms 线性补间（曾用于"平滑滑动"播放头）：上报间隔
    // 50ms < 补间时长 200ms，动画永远在途 → Slint 动画时钟永不停歇 →
    // 以显示器刷新率持续整窗重绘（240Hz 屏实测 237fps、40% CPU）。
    // 20Hz 步进对细进度条视觉上已足够平滑。
    property <float> played-frac:
        TransportState.duration > 0.0 ? min(TransportState.position / TransportState.duration, 1.0) : 0.0;
    // 进度比例：拖拽中跟随手指（不插值，保证跟手）；seek 锁定期钉在目标上
    // （点击跳转不回弹）；其余时间取插值后的播放位置（平滑滑动）。
    property <float> progress-frac:
        TransportState.dragging ? TransportState.drag-fraction
        : (TransportState.seek-lock ? TransportState.seek-lock-frac : played-frac);

    // 底部控制胶囊几何（Rust 侧工具栏悬停检测依赖同一布局，改动需同步 main.rs）。
    property <length> bar-x: (root.width - 330px) / 2;
    // 主控条固定在主区域底部：y = height - 46 - dock-h，与 height 共用同一
    // 动画镜像（dock-h），开合动画期间差值恒等于基准高度 - 46，位置稳定。
    property <length> bar-y: root.height - 46px - dock-h;

    // 最底层：空白区域拖动窗口（含双击打开文件检测）。
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                TransportState.window-drag-down(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.move {
                TransportState.window-drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.up {
                TransportState.window-drag-up();
            }
        }
    }

    // 主容器：玻璃 + 主题双色渐变（保留透明度，毛玻璃透出）。
    // 圆角由 DWM 系统统一裁切（DWMWCP_ROUND），Slint 侧保持直角，
    // 避免双层圆角边缘出现黑色描边。
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 0px;
        clip: true;
        // 兜底深色底（首次加载前），随后由模糊背景图覆盖。
        background: #141924;

        // 柔和背景：低分辨率渐变 + 光斑放大后自带高斯模糊观感。
        // 双层交叉淡入：Rust 侧换曲时把新背景写入隐藏层并翻转 bg-front-showing，
        // 两层 350ms 透明度动画完成柔和过渡。
        Image {
            source: TransportState.bg-image-front;
            opacity: TransportState.bg-front-showing ? 1.0 : 0.0;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: smooth;
            animate opacity { duration: 350ms; easing: ease-in-out; }
        }
        Image {
            source: TransportState.bg-image-back;
            opacity: TransportState.bg-front-showing ? 0.0 : 1.0;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: smooth;
            animate opacity { duration: 350ms; easing: ease-in-out; }
        }

        // 可读性压暗层：任何封面下加深对比，保证白色文字/图标可读。
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #00000030 0%, #00000010 40%, #00000046 100%);
        }

        // 顶部 1px 玻璃高光（中间亮、两端淡出）。
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg, transparent 0%, #ffffff2b 50%, transparent 100%);
        }

        // —— 左上：专辑封面（无封面时整体隐藏）——
        Rectangle {
            x: 16px;
            y: 14px;
            width: 48px;
            height: 48px;
            border-radius: 10px;
            clip: true;
            visible: TransportState.has-cover;
            background: #ffffff0d;
            Image {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                source: TransportState.cover-image;
                image-fit: cover;
                image-rendering: smooth;
            }
            // 发丝描边，让封面在深色背景上有边界感。
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 10px;
                border-width: 1px;
                border-color: #ffffff2b;
                background: transparent;
            }
            drop-shadow-offset-y: 2px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000066;
        }

        // 歌曲名 / 艺术家两行；无封面时左移补位（150ms 平滑过渡）。
        Text {
            x: TransportState.has-cover ? 78px : 18px;
            y: TransportState.track-artist == "" ? 24px : 16px;
            width: root.width - 240px;
            height: 22px;
            text: TransportState.track-title;
            font-size: 15px;
            // 最重要的信息用最重的字重（HarmonyOS Sans Black）。
            font-weight: 900;
            color: #f2f4f8;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
            animate x { duration: 150ms; easing: ease-out; }
            animate y { duration: 150ms; easing: ease-out; }
        }
        Text {
            x: TransportState.has-cover ? 78px : 18px;
            y: 40px;
            width: root.width - 240px;
            height: 16px;
            text: TransportState.track-artist;
            visible: TransportState.track-artist != "";
            font-size: 11px;
            color: #ffffff8c;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
            animate x { duration: 150ms; easing: ease-out; }
        }

        // 右上：关于 / 最小化 / 置顶 / 关闭（亮背景时切换深色内容）。
        IconButton {
            x: root.width - 138px;
            y: 7px;
            button-size: 26px;
            source: @image-url("../icons/信息圆.svg");
            clicked => { AboutState.about-open = true; }
        }
        IconButton {
            x: root.width - 106px;
            y: 7px;
            button-size: 26px;
            source: @image-url("../icons/最小化.svg");
            clicked => { TransportState.minimize-window(); }
        }
        IconButton {
            x: root.width - 74px;
            y: 7px;
            button-size: 26px;
            active: TransportState.always-on-top;
            source: @image-url("../icons/置顶.svg");
            clicked => { TransportState.toggle-pin(); }
        }
        IconButton {
            x: root.width - 42px;
            y: 7px;
            button-size: 26px;
            source: @image-url("../icons/关闭.svg");
            clicked => { TransportState.close-window(); }
        }
        // 有新版本时，关于按钮右上角的主题色小圆点提示。
        Rectangle {
            visible: AboutState.update-state == UpdateState.available
                || AboutState.update-state == UpdateState.downloading
                || AboutState.update-state == UpdateState.ready;
            x: root.width - 138px + 19px;
            y: 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: TransportState.theme-color;
            border-width: 1px;
            border-color: #141924;
        }

        // 波形进度条（视觉核心）。
        WaveformArea {
            x: 20px;
            y: 70px;
            width: root.width - 40px;
            height: 56px;
            progress-frac: root.progress-frac;
        }

        // 底部时间标签（与控制胶囊同一行，两端对齐）。
        Text {
            x: 22px;
            y: root.bar-y + 10px;
            width: 60px;
            height: 18px;
            text: TransportState.position-text;
            font-size: 11px;
            color: #aeb6c2;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
        Text {
            x: root.width - 82px;
            y: root.bar-y + 10px;
            width: 60px;
            height: 18px;
            text: TransportState.duration-text;
            font-size: 11px;
            color: #aeb6c2;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 模式提示（切换模式时短暂显示，浮于底部控制栏上方居中）。
        Text {
            x: control_bar.x + control_bar.width / 2 - 65px;
            y: control_bar.y - 24px;
            width: 130px;
            height: 18px;
            text: TransportState.mode-text;
            opacity: TransportState.mode-showing ? 1.0 : 0.0;
            font-size: 11px;
            color: #e8eaf0;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate opacity { duration: 120ms; }
        }

        // 底部半透明控制栏：模式 → 快退 → 上一曲 → 播放/暂停 → 下一曲 → 快进 → 音量 → 列表。
        control_bar := Rectangle {
            x: root.bar-x;
            y: root.bar-y;
            width: 330px;
            height: 38px;

            // 玻璃胶囊背景：深色玻璃常驻；平时几乎隐形（不显示主题色），
            // 鼠标靠近后显现保证可读性。
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                border-radius: 19px;
                border-width: 1px;
                border-color: TransportState.toolbar-hovered ? #ffffff30 : #ffffff1f;
                background: #0e131d;
                opacity: TransportState.toolbar-hovered ? 0.78 : 0.15;
                animate opacity { duration: 150ms; easing: ease-out; }
                drop-shadow-offset-y: 3px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000040;
            }

            // 主题色叠加层：只在鼠标靠近时轻轻显现。
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                border-radius: 19px;
                background: TransportState.theme-color;
                opacity: TransportState.toolbar-hovered ? 0.18 : 0.0;
                animate opacity { duration: 150ms; easing: ease-out; }
            }

            HorizontalLayout {
                // 显式铺满高度，否则内容会在容器顶部对齐。
                height: parent.height;
                cross-axis-alignment: center;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 7px;
                alignment: center;

                // 模块停靠区开关（阶段 A 基建；真实模块后续接入）。
                IconButton {
                    button-size: 27px;
                    active: DockState.open;
                    source: @image-url("../icons/模块.svg");
                    clicked => { DockState.open = !DockState.open; }
                }
                IconButton {
                    button-size: 27px;
                    source: @image-url("../icons/模式.svg");
                    clicked => { TransportState.cycle-mode(); }
                }
                IconButton {
                    button-size: 27px;
                    source: @image-url("../icons/快退.svg");
                    clicked => { TransportState.seek-relative(-5.0); }
                }
                IconButton {
                    button-size: 27px;
                    source: @image-url("../icons/上一首.svg");
                    clicked => { TransportState.previous(); }
                }
                PlayButton {
                    button-size: 36px;
                    playing: TransportState.playing;
                    clicked => { TransportState.toggle-play(); }
                }
                IconButton {
                    button-size: 27px;
                    source: @image-url("../icons/下一首.svg");
                    clicked => { TransportState.next(); }
                }
                IconButton {
                    button-size: 27px;
                    source: @image-url("../icons/快进.svg");
                    clicked => { TransportState.seek-relative(5.0); }
                }
                IconButton {
                    button-size: 27px;
                    active: TransportState.volume-popup-open;
                    source: @image-url("../icons/音量.svg");
                    clicked => { TransportState.toggle-volume-popup(); }
                }
                IconButton {
                    button-size: 27px;
                    // 抽屉打开或已弹出为独立窗口时都视为激活态。
                    active: PlaylistState.playlist-open || PlaylistState.popped;
                    source: @image-url("../icons/播放列表.svg");
                    clicked => { PlaylistState.toggle-playlist(); }
                }
            }
        }

        // 音量弹层：点击音量按钮后从工具栏右侧滑出。
        Rectangle {
            x: TransportState.volume-popup-open
                ? control_bar.x + control_bar.width + 10px
                : control_bar.x + control_bar.width - 34px;
            y: control_bar.y;
            width: 160px;
            height: 38px;
            opacity: TransportState.volume-popup-open ? 1.0 : 0.0;
            visible: TransportState.volume-popup-open;
            animate x { duration: 150ms; easing: ease-out; }
            animate opacity { duration: 120ms; easing: ease-out; }

            // 玻璃底（与工具栏同款深色玻璃）。
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                border-radius: 19px;
                border-width: 1px;
                border-color: #ffffff26;
                background: #0e131d;
                opacity: 0.85;
                drop-shadow-offset-y: 3px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000040;
            }

            // 主题色叠加层。
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                border-radius: 19px;
                background: TransportState.theme-color;
                opacity: 0.18;
            }

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                alignment: center;

                VolumeBar {
                    width: 92px;
                    volume: TransportState.volume;
                    changed(v) => { TransportState.set-volume(v); }
                }
                Text {
                    width: 36px;
                    text: TransportState.volume-text;
                    font-size: 11px;
                    color: #e8eaf0;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        // 播放列表模块（阶段 0：组件已独立，阶段 C 可弹出新窗口）。
        // 打开时覆盖整个窗口（含停靠区）——用户要求：停靠区开着时抽屉
        // 盖满两层面板，形成更高的列表视口。收起时 visible=false 隐藏
        // （playlist.slint），停靠动画不会把收起的抽屉带着滑动。
        pl-drawer := PlaylistDrawer {
            width: root.width;
            height: root.height;
            closed-y: root.height;
        }

        // 停靠区（阶段 A）：模块面板停靠在主窗口底部，主控条在其上方。
        // 收起动画期间保持可见（dock-h 回落到 0 才隐藏），随窗口底缘幕布式
        // 收起；clip 遮住溢出，内部内容尺寸固定（引用 module-height）不压缩。
        Rectangle {
            visible: dock-h > 0px;
            clip: true;
            x: 0px;
            y: root.height - dock-h;
            width: root.width;
            height: dock-h;

            // 面板玻璃底（尺寸固定，动画中只被容器裁切，不发生压缩形变）。
            Rectangle {
                x: 8px;
                y: 4px;
                width: parent.width - 16px;
                height: DockState.module-height - 10px;
                border-radius: 12px;
                background: #0f131bd9;
                border-width: 1px;
                border-color: #ffffff1f;
            }

            // 模块标签：均衡器（阶段 1 首个真实模块；后续模块在此追加 tab）。
            Rectangle {
                x: 20px;
                y: 8px;
                width: 64px;
                height: 20px;
                border-radius: 10px;
                background: DockState.active == 0
                    ? TransportState.theme-color.with-alpha(0.30) : #ffffff14;
                animate background { duration: 120ms; }
                Text { text: "均衡器"; font-size: 11px; color: #f2f4f8;
                       horizontal-alignment: center; vertical-alignment: center; }
                ta := TouchArea {
                    clicked => { DockState.active = 0; }
                    mouse-cursor: pointer;
                }
            }

            // 关闭停靠区。
            IconButton {
                x: parent.width - 40px;
                y: 8px;
                button-size: 20px;
                source: @image-url("../icons/关闭.svg");
                clicked => { DockState.open = false; }
            }

            // 模块内容（高度引用 module-height：动画中保持固有尺寸）。
            EqPanel {
                x: 12px;
                y: 32px;
                width: parent.width - 24px;
                height: DockState.module-height - 38px;
            }
        }

        // 关于与更新模块（AboutState.about-open 控制显隐）。
        AboutCard {
            width: root.width;
            height: root.height;
        }
        // 打开时窗口级屏蔽滚轮调音量（Rust 侧读 about-open 拦截）。

    }
}
