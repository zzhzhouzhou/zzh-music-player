// 播放列表独立窗口（阶段 C 首落地）：无边框亚克力小窗，承载与停靠抽屉
// 完全相同的 PlaylistPanel。窗口实例由 Rust 侧按需创建销毁（关闭即释放）。
//
// 重要：Slint 1.17 的全局单例按组件实例隔离（slint crate 文档：
// "Global singletons are instantiated once per component"），本窗口的
// PlaylistState / TransportState 是与主窗口无关的另一份实例。列表内容靠
// 共享同一 ModelRc，主题色 / 播放状态 / 粒子时钟 / 当前曲目由事件泵从
// 主窗口实例同步（见 pumps.rs 桥接段）——不要假设属性天然互通。
import { PlaylistState, TransportState } from "state.slint";
import { PlaylistPanel } from "playlist.slint";

export component PlaylistWindow inherits Window {
    no-frame: true;
    background: transparent;
    // 标题不得与主窗口相同：单实例转发按标题 FindWindowW 精确匹配主窗口。
    title: "zzhMusicPlayer Playlist";
    width: 340px;
    height: 520px;
    // 字体：**不要**在此声明 default-font-family: "HarmonyOS Sans SC"。
    // femtovg 每窗口一个 GL 上下文 => 字形缓存按窗口实例独立；弹窗首帧要在
    // 全新缓存里光栅化整张列表的 CJK 字形，实测随列表规模线性上涨
    // （~100 首：弹出 3.8s、收回再 3.8s，UI 线程全程冻结——"弹出像死了一样"
    // 的根因，scripts/popout_probe.ps1 实测；空列表同声明仅 652ms）。
    // 弹窗沿用系统回退字体（瞬时打开）；主窗/抽屉（共享主窗上下文）用 HarmonyOS Sans。

    PlaylistPanel {
        width: 100%;
        height: 100%;
        active: true;
        docked: false;
        // 弹窗右上角关闭按钮：收回独立窗口（位置记忆在 Rust 侧处理）。
        close-requested => { PlaylistState.pop-close(); }
    }

    // 标题区拖动窗口：悬于面板之上，只盖住无交互的标题段（x 0..80），
    // 不挡搜索框（x 84 起）/ 清空 / 关闭。无双击打开文件语义（主窗口专属）。
    TouchArea {
        x: 0px;
        y: 0px;
        width: 80px;
        height: 40px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                TransportState.window-drag-down(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.move {
                TransportState.window-drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.up {
                TransportState.window-drag-up();
            }
        }
    }
}
