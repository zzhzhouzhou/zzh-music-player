// 均衡器面板（阶段 1 首个真实停靠模块）：10 段竖向滑条 ±12dB + 预设 + 开关。
// 窗口无关组件（与 PlaylistPanel 同模式），当前只停靠在主窗口底部；
// 将来开放弹出照抄播放列表的模式。增益回写经 EqState.set-gain 回调到
// Rust 侧（引擎即时生效 + 持久化），面板自身不持有任何音频状态。
import { EqState, TransportState } from "state.slint";
import { IconButton } from "widgets.slint";

// 频段标签（与 audio_engine::EQ_FREQS 一一对应）。
component BandSlider inherits Rectangle {
    in property <int> band;
    in property <string> label;
    in property <float> gain; // -12 ~ +12 dB
    min-width: 34px;

    Text {
        y: 0px;
        width: parent.width;
        height: 12px;
        text: root.gain > 0.5 ? "+" + round(root.gain)
            : root.gain < -0.5 ? round(root.gain) : "0";
        font-size: 10px;
        color: root.gain != 0.0 ? TransportState.theme-color : #9aa3b2;
        horizontal-alignment: center;
    }

    // 滑槽。
    Rectangle {
        x: (parent.width - 4px) / 2;
        y: 12px;
        width: 4px;
        height: parent.height - 46px;
        border-radius: 2px;
        background: #ffffff14;
        // 0dB 中线刻度。
        Rectangle {
            y: parent.height / 2 - 1px;
            width: parent.width;
            height: 1px;
            background: #ffffff2e;
        }
        // 增益填充：从 0dB 中线向增益方向伸展。
        Rectangle {
            width: parent.width;
            height: min(parent.height / 2, abs(root.gain) * parent.height / 24.0);
            y: root.gain >= 0.0 ? parent.height / 2 - self.height : parent.height / 2;
            border-radius: 2px;
            background: TransportState.theme-color.with-alpha(0.75);
        }
        // 拇指。
        Rectangle {
            width: 18px;
            height: 10px;
            x: (parent.width - self.width) / 2;
            y: clamp(parent.height / 2 + root.gain * parent.height / 24.0
                - self.height / 2, 0px, parent.height - self.height);
            border-radius: 5px;
            background: #f2f4f8;
            border-width: 1px;
            border-color: #0f131b;
        }
    }

    ta := TouchArea {
        y: 12px;
        height: parent.height - 46px;
        // 按下即跳值，拖动跟随；方向与滑槽一致（上 = +12dB）。
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down || e.kind == PointerEventKind.move) {
                EqState.set-gain(root.band,
                    clamp((self.height / 2 - self.mouse-y) * 24.0 / self.height, -12.0, 12.0));
            }
        }
        mouse-cursor: ns-resize;
    }

    Text {
        y: parent.height - 30px;
        width: parent.width;
        height: 14px;
        text: root.label;
        font-size: 10px;
        color: #9aa3b2;
        horizontal-alignment: center;
    }
    Text {
        y: parent.height - 16px;
        width: parent.width;
        height: 12px;
        text: "Hz";
        font-size: 8px;
        color: #ffffff38;
        horizontal-alignment: center;
    }
}

export component EqPanel inherits Rectangle {
    HorizontalLayout {
        x: 14px;
        y: 4px;
        width: parent.width - 28px;
        height: parent.height - 8px;
        spacing: 10px;

        // 左列：开关 + dB 标尺说明。
        VerticalLayout {
            width: 88px;
            spacing: 6px;
            alignment: start;

            Rectangle {
                height: 24px;
                border-radius: 12px;
                border-width: 1px;
                border-color: EqState.enabled
                    ? TransportState.theme-color.with-alpha(0.55) : #ffffff1f;
                background: EqState.enabled
                    ? TransportState.theme-color.with-alpha(0.20) : #ffffff0a;
                animate background { duration: 120ms; }
                Text {
                    text: EqState.enabled ? "均衡器 开" : "均衡器 关";
                    font-size: 11px;
                    color: EqState.enabled ? #f2f4f8 : #9aa3b2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { EqState.toggle-enabled(); }
                    mouse-cursor: pointer;
                }
            }
            Text {
                height: 16px;
                text: EqState.enabled ? "±12 dB · 即时生效" : "已旁路（直通）";
                font-size: 10px;
                color: #ffffff59;
                vertical-alignment: center;
            }
            Rectangle { vertical-stretch: 1; }
            Text {
                height: 14px;
                text: "10 段 ISO 倍频程";
                font-size: 10px;
                color: #ffffff38;
                vertical-alignment: center;
            }
        }

        // 预设行（横排 chips，随 active-preset 高亮）。
        HorizontalLayout {
            width: 296px;
            height: 24px;
            spacing: 6px;
            alignment: start;

            for preset[i] in EqState.preset-names: Rectangle {
                width: 44px;
                height: 24px;
                border-radius: 12px;
                border-width: 1px;
                border-color: EqState.active-preset == i + 1
                    ? TransportState.theme-color.with-alpha(0.55) : #ffffff1f;
                background: EqState.active-preset == i + 1
                    ? TransportState.theme-color.with-alpha(0.20) : #ffffff0a;
                animate background { duration: 120ms; }
                Text {
                    text: preset;
                    font-size: 11px;
                    color: EqState.active-preset == i + 1 ? #f2f4f8 : #9aa3b2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { EqState.apply-preset(i + 1); }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // 10 根竖向滑条（禁用态整列降透明度，直观呈现"旁路"）。
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            opacity: EqState.enabled ? 1.0 : 0.45;
            animate opacity { duration: 150ms; }

            for g[i] in EqState.gains: BandSlider {
                band: i;
                gain: g;
                label: EqState.band-labels[i];
            }
        }
    }
}
