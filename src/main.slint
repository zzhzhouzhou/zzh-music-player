// zzhMusicPlayer 主界面：无边框、亚克力毛玻璃 + 主题渐变背景。
// 布局：左上角歌曲信息、右上角窗口控制；中间全宽波形进度条（视觉核心）；
// 底部半透明控制栏（模式/上一曲/播放暂停/下一曲/音量/播放列表）；
// 底部滑出播放列表抽屉。

export global UIState {
    in-out property <float> duration: 0.0;
    in-out property <float> position: 0.0;
    in-out property <bool> playing: false;
    in-out property <bool> always-on-top: false;
    // “关于”对话框是否打开。
    in-out property <bool> about-open: false;
    // 鼠标是否靠近底部工具栏（悬停时工具栏变实）。
    in-out property <bool> toolbar-hovered: false;
    in-out property <float> volume: 1.0;
    in-out property <bool> volume-popup-open: false;
    in-out property <string> volume-text: "";
    // 粒子系统时间（0~1 循环），驱动白色粒子持续生成与飘散。
    in-out property <float> particle-time: 0.0;
    // 主题色与背景渐变（封面主色调 / 文件名哈希）。
    in-out property <color> theme-color: #5ac8fa;
    // 柔和模糊感背景位图（低分辨率渐变 + 主题色光斑放大）。
    in-out property <image> bg-image;
    // 播放列表。
    in-out property <[string]> playlist: [];
    in-out property <int> playlist-current: -1;
    in-out property <bool> playlist-open: false;
    // 播放模式提示。
    in-out property <string> mode-text: "顺序播放";
    in-out property <bool> mode-showing: false;
    // 进度条拖拽中：暂停波形实时推进，跟随手指预览。
    in-out property <bool> dragging: false;
    in-out property <float> drag-fraction: 0.0;
    // 跳转已发出、等待播放位置确认（防止进度条回弹）。
    in-out property <bool> seek-pending: false;
    in-out property <image> wave-bg-image;
    in-out property <image> wave-fg-image;
    in-out property <string> track-title: "";
    in-out property <string> track-artist: "";

    callback toggle-play();
    callback next();
    callback previous();
    callback cycle-mode();
    callback play-at(int);
    callback remove-track(int);
    callback clear-playlist();
    callback toggle-playlist();
    callback seek-requested(float);
    callback seek-relative(float);
    callback set-volume(float);
    callback toggle-volume-popup();
    callback close-window();
    callback minimize-window();
    callback toggle-pin();
    // 窗口拖动（空白区域按下/移动/松开），坐标为局部像素。
    callback window-drag-down(float, float);
    callback window-drag-move(float, float);
    callback window-drag-up();
}

// 圆形图标按钮：悬停放大、按下缩小回弹。
component IconButton inherits Rectangle {
    in property <image> source;
    in property <bool> active: false;
    in property <length> button-size: 30px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: button-size / 2;
    // 半透明深底：hover 时由 opacity 提亮，保持毛玻璃透出。
    background: active ? #3d4150cc : #262b3680;
    transform-scale: ta.pressed ? 0.92 : (ta.has-hover ? 1.05 : 1.0);
    opacity: ta.has-hover ? 0.95 : 1.0;
    animate transform-scale { duration: 100ms; easing: ease-out; }
    animate opacity { duration: 100ms; easing: ease-out; }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: UIState.theme-color;
        // 空闲时透明度很低，几乎不可见；悬停时稍明显
        opacity: ta.has-hover ? 0.20 : 0.12;
        animate opacity { duration: 150ms; easing: ease-out; }
    }

    Image {
        source: root.source;
        // 显式居中：未指定 y 的元素在 Slint 中会顶部对齐。
        x: (button-size - button-size * 0.56) / 2;
        y: (button-size - button-size * 0.56) / 2;
        width: button-size * 0.56;
        height: button-size * 0.56;
        image-fit: contain;
        image-rendering: smooth;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// 播放/暂停按钮：两个图标 150ms 透明度交叉淡入淡出。
component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <length> button-size: 36px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: button-size / 2;
    // 半透明深底（透明度与控制栏图标按钮一致）。
    background: #2c3240b3;
    transform-scale: ta.pressed ? 0.92 : (ta.has-hover ? 1.05 : 1.0);
    animate transform-scale { duration: 100ms; easing: ease-out; }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: UIState.theme-color;
        opacity: ta.has-hover ? 0.20 : 0.12;
        animate opacity { duration: 150ms; easing: ease-out; }
    }

    Image {
        source: @image-url("../icons/播放中.svg");
        x: (button-size - button-size * 0.56) / 2;
        y: (button-size - button-size * 0.56) / 2;
        width: button-size * 0.56;
        height: button-size * 0.56;
        image-fit: contain;
        image-rendering: smooth;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.playing ? 1.0 : 0.0;
        animate opacity { duration: 150ms; }
    }
    Image {
        source: @image-url("../icons/暂停.svg");
        x: (button-size - button-size * 0.56) / 2;
        y: (button-size - button-size * 0.56) / 2;
        width: button-size * 0.56;
        height: button-size * 0.56;
        image-fit: contain;
        image-rendering: smooth;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.playing ? 0.0 : 1.0;
        animate opacity { duration: 150ms; }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// 横向音量条：自左向右按百分比填充。
component VolumeBar inherits Rectangle {
    in property <float> volume: 1.0;
    callback changed(float);

    width: 110px;
    height: 16px;
    border-radius: 8px;
    background: #ffffff1c;

    Rectangle {
        x: 2px;
        y: 2px;
        width: max((parent.width - 4px) * clamp(root.volume, 0.0, 1.0), 0px);
        height: parent.height - 4px;
        border-radius: 6px;
        background: UIState.theme-color;
    }

    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down
                || (e.kind == PointerEventKind.move && self.pressed)
            {
                root.changed(clamp(self.mouse-x / root.width, 0.0, 1.0));
            }
        }
        mouse-cursor: pointer;
    }
}

// 播放列表行：曲名 + 移除按钮，当前曲目高亮。
component PlaylistRow inherits Rectangle {
    in property <string> text;
    in property <int> index;
    callback clicked();
    callback remove();

    height: 26px;
    border-radius: 6px;
    background: index == UIState.playlist-current
        ? UIState.theme-color.with-alpha(0.22)
        : transparent;

    Text {
        x: 12px;
        width: parent.width - 40px;
        height: 100%;
        text: root.text;
        color: index == UIState.playlist-current ? #ffffff : #cfd4dd;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    // 删除按钮放在最后（z 序最上层），避免被整行的 TouchArea 盖住而无法点击。
    Image {
        x: parent.width - 30px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../icons/删除.svg");
        image-fit: contain;
        image-rendering: smooth;
        TouchArea {
            clicked => { root.remove(); }
            mouse-cursor: pointer;
        }
    }
}

// 波形进度区：全宽主题高亮 + 光晕 + 拖尾粒子 + 底部律动光带。
component WaveformArea inherits Rectangle {
    in property <float> progress-frac;

    horizontal-stretch: 1;
    background: transparent;

    // 整曲波形（半透明白，作为灰色底）。
    Image {
        source: UIState.wave-bg-image;
        width: 100%;
        height: 100%;
        image-rendering: smooth;
    }

    // 已播部分：裁剪容器只露出左侧 progress 宽度，内部波形保持整条宽度，
    // 因此高亮与原图同比例，从左往右推进，不随进度伸缩。
    Rectangle {
        // 显式 x=0：未指定 x 的元素会被 Slint 水平居中。
        x: 0px;
        clip: true;
        width: max(parent.width * progress-frac, 0px);
        height: 100%;
        Image {
            x: 0px;
            source: UIState.wave-fg-image;
            width: root.width;
            height: root.height;
            image-fit: fill;
            image-rendering: smooth;
        }
    }

    // 进度竖线（主题色）。
    Rectangle {
        x: max(parent.width * progress-frac - 1px, 0px);
        width: 2px;
        height: 100%;
        background: UIState.theme-color;
        opacity: 0.95;
    }

    // 进度线径向渐变光晕（中心亮、向外透明）。
    Rectangle {
        x: max(parent.width * progress-frac - 38px, 0px);
        y: max(parent.height / 2 - 38px, 0px);
        width: 76px;
        height: 76px;
        background: @radial-gradient(
            circle,
            UIState.theme-color.with-alpha(0.38) 0%,
            UIState.theme-color.with-alpha(0.12) 45%,
            transparent 100%
        );
    }

    // 持续生成的白色粒子：在进度竖线处随机散布出现，各自以不同速度
    // 向左后方飘散、随年龄缩小并逐渐消失（伪随机取模确定外观，非正弦排布）。
    for p[i] in [0.0, 0.23, 0.11, 0.47, 0.05, 0.62, 0.34, 0.81]: Rectangle {
        property <float> age: mod(UIState.particle-time + p, 1.0);
        // 随机散布高度：伪随机取模，范围约 ±25% 波形高度。
        property <length> yoff: ((mod(i * 31, 7) * 2 + mod(i * 17, 5) - 8) * parent.height) / 30;
        // 随机横向飘散速度（68 / 88 / 108 像素每周期）。
        property <length> speed: 68px + mod(i, 3) * 20px;
        x: max(parent.width * progress-frac - age * speed, 0px);
        // 主高度随机 + 微小幅值抖动（0.05），不形成正弦形状。
        y: max(parent.height / 2 + yoff + sin(age * 360deg + i * 77deg) * parent.height * 0.05 - 1.5px, 0px);
        width: max(2px, 3px - age * (1px + mod(i, 2) * 1px));
        height: max(2px, 3px - age * (1px + mod(i, 2) * 1px));
        border-radius: 1.5px;
        background: #ffffff;
        opacity: pow(1.0 - age, 1.4 + mod(i, 3) * 0.4);
    }

    // 点击/拖拽跳转（按下后 Slint 捕获指针，mouse-x 持续跟随）。
    TouchArea {
        property <float> preview: min(max(self.mouse-x / root.width, 0.0), 1.0);
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                UIState.dragging = true;
                UIState.drag-fraction = preview;
            } else if e.kind == PointerEventKind.move {
                if UIState.dragging {
                    UIState.drag-fraction = preview;
                }
            } else if e.kind == PointerEventKind.up {
                if UIState.dragging {
                    UIState.seek-requested(preview);
                    // 保持预览位置，等播放位置确认后再复位，避免回弹。
                    UIState.seek-pending = true;
                }
            }
        }
        mouse-cursor: pointer;
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "zzhMusicPlayer";
    width: 720px;
    height: 170px;
    default-font-family: "HarmonyOS Sans SC";

    // 全局快捷键：空格 播放/暂停，左右方向键 快退/快进 5 秒。
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        KeyBinding {
            keys: @keys(Space);
            activated => { UIState.toggle-play(); }
        }
        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { UIState.seek-relative(-5.0); }
        }
        KeyBinding {
            keys: @keys(RightArrow);
            activated => { UIState.seek-relative(5.0); }
        }
    }

    // 进度比例：拖拽中跟随手指，否则由播放位置决定。
    property <float> progress-frac:
        UIState.dragging ? UIState.drag-fraction
        : (UIState.duration > 0.0 ? min(UIState.position / UIState.duration, 1.0) : 0.0);

    // 最底层：空白区域拖动窗口（含双击打开文件检测）。
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                UIState.window-drag-down(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.move {
                UIState.window-drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.up {
                UIState.window-drag-up();
            }
        }
    }

    // 主容器：玻璃 + 主题双色渐变（保留透明度，毛玻璃透出）。
    // 圆角由 DWM 系统统一裁切（DWMWCP_ROUND），Slint 侧保持直角，
    // 避免双层圆角边缘出现黑色描边。
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 0px;
        clip: true;
        // 兜底深色底（首次加载前），随后由模糊背景图覆盖。
        background: #141924;

        // 柔和背景：低分辨率渐变 + 光斑放大后自带高斯模糊观感。
        Image {
            source: UIState.bg-image;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: smooth;
        }

        // 左上：歌曲信息。
        Text {
            x: 16px;
            y: 10px;
            width: root.width - 210px;
            height: 22px;
            text: UIState.track-title == ""
                ? ""
                : (UIState.track-artist == ""
                    ? UIState.track-title
                    : UIState.track-title + " — " + UIState.track-artist);
            font-size: 15px;
            font-weight: 600;
            color: #f2f4f8;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        // 右上：关于 / 最小化 / 置顶 / 关闭。
        IconButton {
            x: root.width - 138px;
            y: 7px;
            button-size: 26px;
            source: @image-url("../icons/信息圆.svg");
            clicked => { UIState.about-open = true; }
        }
        IconButton {
            x: root.width - 106px;
            y: 7px;
            button-size: 26px;
            source: @image-url("../icons/最小化.svg");
            clicked => { UIState.minimize-window(); }
        }
        IconButton {
            x: root.width - 74px;
            y: 7px;
            button-size: 26px;
            active: UIState.always-on-top;
            source: @image-url("../icons/置顶.svg");
            clicked => { UIState.toggle-pin(); }
        }
        IconButton {
            x: root.width - 42px;
            y: 7px;
            button-size: 26px;
            source: @image-url("../icons/关闭.svg");
            clicked => { UIState.close-window(); }
        }

        // 波形进度条（视觉核心，横贯全宽，约占窗口 55% 高度）。
        WaveformArea {
            x: 0px;
            y: 40px;
            width: root.width;
            height: root.height * 0.55;
            progress-frac: root.progress-frac;
        }

        // 模式提示（切换模式时短暂显示，浮于底部控制栏上方居中）。
        Text {
            x: control_bar.x + control_bar.width / 2 - 65px;
            y: control_bar.y - 22px;
            width: 130px;
            height: 18px;
            text: UIState.mode-text;
            opacity: UIState.mode-showing ? 1.0 : 0.0;
            font-size: 11px;
            color: #e8eaf0;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate opacity { duration: 120ms; }
        }

        // 底部半透明控制栏：模式 → 快退 → 上一曲 → 播放/暂停 → 下一曲 → 快进 → 音量 → 列表。
        control_bar := Rectangle {
            x: (root.width - 300px) / 2;
            y: root.height - 50px;
            width: 300px;
            height: 40px;

            // 玻璃胶囊背景：空闲时很淡，鼠标靠近后变实，保证可读性。
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                border-radius: 20px;
                background: #131823;
                opacity: UIState.toolbar-hovered ? 0.88 : 0.30;
                animate opacity { duration: 150ms; easing: ease-out; }
                drop-shadow-offset-y: 3px;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000059;
            }

            // 新增：主题色叠加层（与底层完全重叠）
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                border-radius: 20px;
                background: UIState.theme-color;
                // 空闲时几乎看不见，鼠标靠近工具栏时微微显现
                opacity: UIState.toolbar-hovered ? 0.18 : 0.08;
                animate opacity { duration: 150ms; easing: ease-out; }
            }

            // 玻璃顶部高光（1px 细微反光）。
            //Rectangle {
            //    x: 7px;
            //    y: 1px;
            //    width: parent.width - 16px;
            //    height: 1px;
            //    border-radius: 1px;
            //    background: #ffffff1c;
            //    opacity: UIState.toolbar-hovered ? 1.0 : 0.35;
            //    animate opacity { duration: 150ms; easing: ease-out; }
            //}

            HorizontalLayout {
                // 显式铺满高度，否则内容会在容器顶部对齐。
                height: parent.height;
                cross-axis-alignment: center;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 7px;
                alignment: center;

                IconButton {
                    button-size: 28px;
                    source: @image-url("../icons/模式.svg");
                    clicked => { UIState.cycle-mode(); }
                }
                IconButton {
                    button-size: 28px;
                    source: @image-url("../icons/快退.svg");
                    clicked => { UIState.seek-relative(-5.0); }
                }
                IconButton {
                    button-size: 28px;
                    source: @image-url("../icons/上一首.svg");
                    clicked => { UIState.previous(); }
                }
                PlayButton {
                    button-size: 34px;
                    playing: UIState.playing;
                    clicked => { UIState.toggle-play(); }
                }
                IconButton {
                    button-size: 28px;
                    source: @image-url("../icons/下一首.svg");
                    clicked => { UIState.next(); }
                }
                IconButton {
                    button-size: 28px;
                    source: @image-url("../icons/快进.svg");
                    clicked => { UIState.seek-relative(5.0); }
                }
                IconButton {
                    button-size: 28px;
                    active: UIState.volume-popup-open;
                    source: @image-url("../icons/音量.svg");
                    clicked => { UIState.toggle-volume-popup(); }
                }
                IconButton {
                    button-size: 28px;
                    active: UIState.playlist-open;
                    source: @image-url("../icons/播放列表.svg");
                    clicked => { UIState.toggle-playlist(); }
                }
            }
        }

        // 音量弹层：点击音量按钮后从工具栏右侧滑出。
        Rectangle {
            x: UIState.volume-popup-open
                ? control_bar.x + control_bar.width + 10px
                : control_bar.x + control_bar.width - 34px;
            y: control_bar.y;
            width: 160px;
            height: 40px;
            border-radius: 20px;
            background: #131823c9;
            drop-shadow-offset-y: 3px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000059;
            opacity: UIState.volume-popup-open ? 1.0 : 0.0;
            visible: UIState.volume-popup-open;
            animate x { duration: 150ms; easing: ease-out; }
            animate opacity { duration: 120ms; easing: ease-out; }

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                alignment: center;

                VolumeBar {
                    width: 92px;
                    volume: UIState.volume;
                    changed(v) => { UIState.set-volume(v); }
                }
                Text {
                    width: 36px;
                    text: UIState.volume-text;
                    font-size: 11px;
                    color: #e8eaf0;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        // 播放列表抽屉遮罩（打开时点外部收起）。
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: #00000066;
            visible: UIState.playlist-open;
            TouchArea {
                clicked => { UIState.toggle-playlist(); }
            }
        }

        // 播放列表抽屉：从底部滑出。
        Rectangle {
            x: 0px;
            y: UIState.playlist-open ? root.height - 156px : root.height;
            width: root.width;
            height: 156px;
            background: #151a23f2;
            border-radius: 14px;
            animate y { duration: 220ms; easing: ease-out; }

            // 头部：标题 + 清空 + 收起。
            Text {
                x: 16px;
                y: 8px;
                width: 140px;
                height: 20px;
                text: "播放列表";
                font-size: 13px;
                font-weight: 600;
                color: #f2f4f8;
                vertical-alignment: center;
            }
            Text {
                x: parent.width - 104px;
                y: 8px;
                width: 44px;
                height: 20px;
                text: "清空";
                font-size: 12px;
                color: #9aa3b2;
                horizontal-alignment: center;
                vertical-alignment: center;
                TouchArea {
                    clicked => { UIState.clear-playlist(); }
                    mouse-cursor: pointer;
                }
            }
            IconButton {
                x: parent.width - 46px;
                y: 5px;
                button-size: 24px;
                source: @image-url("../icons/关闭.svg");
                clicked => { UIState.toggle-playlist(); }
            }

            Flickable {
                x: 8px;
                y: 34px;
                width: parent.width - 16px;
                height: parent.height - 40px;
                viewport-height: UIState.playlist.length * 26px;
                VerticalLayout {
                    for item[i] in UIState.playlist: PlaylistRow {
                        text: item;
                        index: i;
                        clicked => { UIState.play-at(i); }
                        remove => { UIState.remove-track(i); }
                    }
                }
            }
        }

        // —— “关于”对话框（覆盖在最上层，点击空白处关闭）——
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: #00000066;
            visible: UIState.about-open;
            TouchArea {
                clicked => { UIState.about-open = false; }
            }

            Rectangle {
                x: (root.width - 340px) / 2;
                y: (root.height - 136px) / 2;
                width: 340px;
                height: 136px;
                border-radius: 16px;
                background: #171c26f5;
                drop-shadow-offset-y: 4px;
                drop-shadow-blur: 20px;
                drop-shadow-color: #00000088;

                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 12px;
                    spacing: 5px;

                    Text {
                        text: "关于 zzhMusicPlayer";
                        font-size: 15px;
                        font-weight: 600;
                        color: #f2f4f8;
                    }

                    // ========== 在此编辑“关于”内容（下面五行文字） ==========
                    Text {
                        text: "开发者：zzhzhouzhou";
                        font-size: 12px;
                        color: #cfd4dd;
                    }
                    Text {
                        text: "简单、轻量、纯粹的音频播放器";
                        font-size: 12px;
                        color: #cfd4dd;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "技术：Rust · Slint · rodio · symphonia";
                        font-size: 12px;
                        color: #cfd4dd;
                    }
                    Text {
                        text: "版本：1.0.0";
                        font-size: 12px;
                        color: #cfd4dd;
                    }
                    // ========== 编辑结束 ==========
                }

                IconButton {
                    x: parent.width - 36px;
                    y: 6px;
                    button-size: 24px;
                    source: @image-url("../icons/关闭.svg");
                    clicked => { UIState.about-open = false; }
                }
            }
        }
    }
}
