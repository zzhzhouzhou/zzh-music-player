// zzhMusicPlayer 主界面：无边框、亚克力毛玻璃背景。
// 布局：上方标题（歌曲名 — 艺术家）+ 右上角关闭按钮；
// 中间一排三个按钮（快退 5 秒 / 播放暂停 / 快进 5 秒）；
// 下方一行播放进度条 + 横向音量条 + 音量百分比（调整时显示）。

export global UIState {
    in-out property <float> duration: 0.0;
    in-out property <float> position: 0.0;
    in-out property <bool> playing: false;
    in-out property <float> volume: 1.0;
    in-out property <bool> volume-showing: false;
    in-out property <string> volume-text: "";
    in-out property <bool> always-on-top: false;
    // 进度条拖拽中：暂停波形实时推进，跟随手指预览。
    in-out property <bool> dragging: false;
    in-out property <float> drag-fraction: 0.0;
    in-out property <image> wave-bg-image;
    in-out property <image> wave-fg-image;
    in-out property <string> track-title: "";
    in-out property <string> track-artist: "";

    callback toggle-play();
    callback toggle-pin();
    callback seek-requested(float);
    callback seek-relative(float);
    callback set-volume(float);
    callback close-window();
    // 窗口拖动（空白区域按下/移动/松开），坐标为局部像素。
    callback window-drag-down(float, float);
    callback window-drag-move(float, float);
    callback window-drag-up();
}

// 圆形图标按钮（极简深色风格，图标为白色 SVG）。
component IconButton inherits Rectangle {
    in property <image> source;
    in property <bool> active: false;
    in property <length> button-size: 36px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: button-size / 2;
    background: active ? #3d4150ff : #262b36cc;

    Image {
        source: root.source;
        width: button-size * 0.56;
        height: button-size * 0.56;
        image-fit: contain;
        image-rendering: smooth;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// 横向音量条：自左向右按百分比填充。
component VolumeBar inherits Rectangle {
    in property <float> volume: 1.0;
    callback changed(float);

    width: 140px;
    height: 20px;
    border-radius: 10px;
    background: #ffffff14;

    Rectangle {
        x: 2px;
        y: 2px;
        width: max((parent.width - 4px) * clamp(root.volume, 0.0, 1.0), 0px);
        height: parent.height - 4px;
        border-radius: 8px;
        background: #5ac8facc;
    }

    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down
                || (e.kind == PointerEventKind.move && self.pressed)
            {
                root.changed(clamp(self.mouse-x / root.width, 0.0, 1.0));
            }
        }
        mouse-cursor: pointer;
    }
}

// 波形进度区：整曲波形背景 + 已播部分高亮（从左往右，不伸缩）+ 拖拽跳转。
component WaveformArea inherits Rectangle {
    in property <float> progress-frac;

    height: 24px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: #0000002e;

    // 整曲波形（半透明背景色）。
    Image {
        source: UIState.wave-bg-image;
        width: 100%;
        height: 100%;
        image-rendering: smooth;
    }

    // 已播部分：裁剪容器只露出左侧 progress 宽度，内部波形保持整条宽度，
    // 因此高亮与原图同比例，从左往右推进，不随进度伸缩。
    Rectangle {
        // 显式 x=0：未指定 x 的元素会被 Slint 水平居中，导致高亮从中间向两边展开。
        x: 0px;
        clip: true;
        width: max(parent.width * progress-frac, 0px);
        height: 100%;
        Image {
            x: 0px;
            source: UIState.wave-fg-image;
            width: root.width;
            height: root.height;
            image-fit: fill;
            image-rendering: smooth;
        }
    }

    // 进度指示线。
    Rectangle {
        x: max(parent.width * progress-frac - 1px, 0px);
        width: 2px;
        height: 100%;
        background: #5ac8fa80;
    }

    // 点击/拖拽跳转（按下后 Slint 捕获指针，mouse-x 持续跟随）。
    TouchArea {
        property <float> preview: min(max(self.mouse-x / root.width, 0.0), 1.0);
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                UIState.dragging = true;
                UIState.drag-fraction = preview;
            } else if e.kind == PointerEventKind.move {
                if UIState.dragging {
                    UIState.drag-fraction = preview;
                }
            } else if e.kind == PointerEventKind.up {
                if UIState.dragging {
                    UIState.seek-requested(preview);
                    UIState.dragging = false;
                }
            }
        }
        mouse-cursor: pointer;
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "zzhMusicPlayer";
    width: 620px;
    height: 124px;
    default-font-family: "Segoe UI";

    // 全局快捷键：空格 播放/暂停，左右方向键 快退/快进 5 秒。
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        KeyBinding {
            keys: @keys(Space);
            activated => { UIState.toggle-play(); }
        }
        KeyBinding {
            keys: @keys(LeftArrow);
            activated => { UIState.seek-relative(-5.0); }
        }
        KeyBinding {
            keys: @keys(RightArrow);
            activated => { UIState.seek-relative(5.0); }
        }
    }

    // 进度比例：拖拽中跟随手指，否则由播放位置决定。
    property <float> progress-frac:
        UIState.dragging ? UIState.drag-fraction
        : (UIState.duration > 0.0 ? min(UIState.position / UIState.duration, 1.0) : 0.0);

    // 最底层：空白区域拖动窗口。
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                UIState.window-drag-down(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.move {
                UIState.window-drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
            } else if e.kind == PointerEventKind.up {
                UIState.window-drag-up();
            }
        }
    }

    // 主容器：圆角 + 半透明深色底（亚克力透出，保持深色可读）。
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 14px;
        clip: true;
        background: #171c26aa;

        // 右上角关闭按钮。
        IconButton {
            x: root.width - 40px;
            y: 6px;
            button-size: 28px;
            source: @image-url("../icons/关闭.svg");
            clicked => { UIState.close-window(); }
        }

        // 顶部标题：歌曲名 — 艺术家（来自元数据），居中，超长省略。
        Text {
            x: 0px;
            y: 8px;
            width: root.width;
            height: 20px;
            text: UIState.track-title == ""
                ? ""
                : (UIState.track-artist == ""
                    ? UIState.track-title
                    : UIState.track-title + " — " + UIState.track-artist);
            font-family: "Microsoft YaHei UI";
            font-size: 13px;
            font-weight: 600;
            color: #e8eaf0ff;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        // 中间一排：快退 5 秒 / 播放暂停 / 快进 5 秒。
        HorizontalLayout {
            x: 0px;
            y: 36px;
            width: root.width;
            height: 44px;
            spacing: 18px;
            alignment: center;

            IconButton {
                button-size: 38px;
                source: @image-url("../icons/快退.svg");
                clicked => { UIState.seek-relative(-5.0); }
            }
            IconButton {
                button-size: 46px;
                // 播放状态显示“播放中”图标，暂停状态显示“暂停”图标。
                source: UIState.playing
                    ? @image-url("../icons/播放中.svg")
                    : @image-url("../icons/暂停.svg");
                clicked => { UIState.toggle-play(); }
            }
            IconButton {
                button-size: 38px;
                source: @image-url("../icons/快进.svg");
                clicked => { UIState.seek-relative(5.0); }
            }
        }

        // 下方一行：播放进度条 + 音量图标 + 横向音量条 + 音量百分比。
        HorizontalLayout {
            x: 0px;
            y: 88px;
            width: root.width;
            height: 24px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;

            WaveformArea {
                progress-frac: root.progress-frac;
            }
            Image {
                source: @image-url("../icons/音量.svg");
                width: 18px;
                height: 18px;
                image-fit: contain;
                image-rendering: smooth;
                vertical-alignment: center;
            }
            VolumeBar {
                width: 140px;
                volume: UIState.volume;
                changed(v) => { UIState.set-volume(v); }
            }
            Text {
                width: 42px;
                text: UIState.volume-text;
                opacity: UIState.volume-showing ? 1.0 : 0.0;
                font-size: 11px;
                color: #9fe0ff;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}
