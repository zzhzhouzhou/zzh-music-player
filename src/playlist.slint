// 播放列表模块：面板组件窗口无关（停靠抽屉与独立弹出窗口共用同一面板），
// 由主窗口实例化为全窗口抽屉（PlaylistDrawer），或承载于独立窗口
// （playlist_window.slint，阶段 C）。Slint 全局单例按组件实例隔离，
// 跨窗口状态同步由 Rust 侧桥接（共享模型 + 泵同步，见 pumps.rs）。
import { PlaylistState, TransportState, PlaylistEntry } from "state.slint";
import { IconButton } from "widgets.slint";

export component PlaylistRow inherits Rectangle {
    in property <string> text;
    in property <int> index;
    in property <int> real;
    callback remove();
    callback open-folder();

    height: 30px;
    border-radius: 8px;
    background: Math.abs(index - PlaylistState.reorder-to) < 0.5
            && PlaylistState.reorder-from >= 0
            && Math.abs(PlaylistState.reorder-from - PlaylistState.reorder-to) > 0.5
        ? TransportState.theme-color.with-alpha(0.32)
        : real == PlaylistState.playlist-current
            ? TransportState.theme-color.with-alpha(0.20)
            : (PlaylistState.hover-row == index ? #ffffff0d : transparent);
    animate background { duration: 100ms; easing: ease-out; }
    // 正被拖动的行压暗（浮块代替它显示），松手或点击后恢复。
    opacity: PlaylistState.reorder-from == index && PlaylistState.reorder-to >= 0.0 ? 0.22 : 1.0;
    animate opacity { duration: 120ms; easing: ease-out; }

    // 拖动手柄（六点 grip）：拖动排序的视觉锚点；搜索过滤中不显示（排序禁用）。
    Image {
        x: 7px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("../icons/拖动.svg");
        image-fit: contain;
        image-rendering: smooth;
        visible: PlaylistState.search-text == "";
        opacity: PlaylistState.hover-row == index || PlaylistState.reorder-from == index ? 0.95 : 0.4;
        animate opacity { duration: 120ms; }
    }

    Text {
        x: 26px;
        width: parent.width - 146px;
        height: 100%;
        text: root.text;
        color: real == PlaylistState.playlist-current ? #ffffff : #c6ccd6;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    // 正在播放的迷你均衡器（复用全局粒子时钟；暂停时静止为短柱）。
    Rectangle {
        visible: real == PlaylistState.playlist-current;
        x: parent.width - 80px;
        y: (parent.height - 12px) / 2;
        width: 13px;
        height: 12px;
        property <length> amp: TransportState.playing ? 7px : 0px;
        Rectangle {
            x: 0px;
            width: 3px;
            y: (parent.height - self.height) / 2;
            height: 5px + (sin(TransportState.particle-time * 900deg) * 0.5 + 0.5) * parent.amp;
            border-radius: 1.5px;
            background: TransportState.theme-color;
            animate height { duration: 90ms; easing: ease-out; }
        }
        Rectangle {
            x: 5px;
            width: 3px;
            y: (parent.height - self.height) / 2;
            height: 5px + (sin(TransportState.particle-time * 900deg + 130deg) * 0.5 + 0.5) * parent.amp;
            border-radius: 1.5px;
            background: TransportState.theme-color;
            animate height { duration: 90ms; easing: ease-out; }
        }
        Rectangle {
            x: 10px;
            width: 3px;
            y: (parent.height - self.height) / 2;
            height: 5px + (sin(TransportState.particle-time * 900deg + 260deg) * 0.5 + 0.5) * parent.amp;
            border-radius: 1.5px;
            background: TransportState.theme-color;
            animate height { duration: 90ms; easing: ease-out; }
        }
    }

    // 打开所在文件夹按钮（删除按钮左侧）。
    Image {
        x: parent.width - 54px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../icons/文件夹.svg");
        image-fit: contain;
        image-rendering: smooth;
        opacity: PlaylistState.hover-button == 1.0 && PlaylistState.hover-row == index ? 1.0
            : (PlaylistState.hover-row == index || real == PlaylistState.playlist-current ? 0.75 : 0.35);
        animate opacity { duration: 120ms; }
        folder-ta := TouchArea {
            clicked => { root.open-folder(); }
            mouse-cursor: pointer;
        }
    }

    // 删除按钮放在最后（z 序最上层），避免被整行的 TouchArea 盖住而无法点击。
    Image {
        x: parent.width - 32px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../icons/删除.svg");
        image-fit: contain;
        image-rendering: smooth;
        opacity: PlaylistState.hover-button == 2.0 && PlaylistState.hover-row == index ? 1.0
            : (PlaylistState.hover-row == index || real == PlaylistState.playlist-current ? 0.9 : 0.45);
        animate opacity { duration: 120ms; }
        del-ta := TouchArea {
            clicked => { root.remove(); }
            mouse-cursor: pointer;
        }
    }
}

// 播放列表面板：搜索 / 列表 / 拖拽排序 / 浮块，不含抽屉的开合动画外壳。
// active：列表覆盖层与交互是否启用（抽屉形态传 playlist-open，弹窗恒为 true）。
// docked：是否处于主窗口抽屉形态（决定顶部下拉收起手势是否启用）。
// close-requested：右上角关闭按钮（抽屉形态收起抽屉，弹窗形态收回窗口）。
export component PlaylistPanel inherits Rectangle {
    in property <bool> active: false;
    in property <bool> docked: false;
    // 圆角半径：抽屉形态 14px（窗口矩形大、圆角是面板自己的装饰）；
    // 弹窗形态由 playlist_window.slint 覆写为 8px——必须与 Win11 DWM
    // 系统圆角（DWMWCP_ROUND ≈ 8px）一致，否则面板圆角与系统裁剪
    // 叠出"圆角缺一块"的双圆角缝隙（用户实测反馈）。
    in property <length> corner-radius: 14px;
    callback close-requested();

    public function collapse-search() {
        PlaylistState.search-open = false;
        PlaylistState.search-text = "";
        PlaylistState.search-edited("");
    }

    // 面板本体：半透明深底透出下层毛玻璃；叠一层极淡主题色（全局补间
    // 自动随换曲过渡），保持整体色调统一。
    background: #0f131bee;
    border-radius: root.corner-radius;

    // 极淡主题色叠加层。
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        border-radius: root.corner-radius;
        background: TransportState.theme-color;
        opacity: 0.08;
    }

    // 玻璃顶缘高光。
    Rectangle {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 1px;
        background: @linear-gradient(90deg, transparent 0%, #ffffff38 50%, transparent 100%);
    }

    // 顶部拖动把手装饰。
    Rectangle {
        x: (parent.width - 32px) / 2;
        y: 6px;
        width: 32px;
        height: 4px;
        border-radius: 2px;
        background: #ffffff26;
    }

    // 顶部抓取区：按住把手一带向下拖动超过 36px 收起抽屉（仅抽屉形态）。
    // 独立弹窗形态（docked=false）则整条顶带兼作窗口拖动把手——转发给
    // 窗口拖动回调，可拖区域从 80px 标题块扩大到全宽顶带（搜索框/关闭
    // 按钮声明在其后，z 序在其上，交互不受影响）。
    // 声明在头部按钮之前：搜索框 / 关闭按钮落在其上的部分优先响应。
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 20px;
        grab-ta := TouchArea {
            property <length> press-y: 0px;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    press-y = self.mouse-y;
                    if (!root.docked) {
                        TransportState.window-drag-down(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                } else if e.kind == PointerEventKind.move {
                    if root.docked && PlaylistState.playlist-open
                        && (self.mouse-y - press-y) > 36px
                    {
                        root.collapse-search();
                        PlaylistState.toggle-playlist();
                    } else if (!root.docked) {
                        TransportState.window-drag-move(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                } else if e.kind == PointerEventKind.up {
                    if (!root.docked) {
                        TransportState.window-drag-up();
                    }
                }
            }
        }
    }

    // 头部：标题 + 搜索框（点图标后从标题右侧滑出，图标内嵌框内）+ 清空 + 收起。
    Text {
        x: 16px;
        y: 15px;
        width: 64px;
        height: 20px;
        text: "播放列表";
        font-size: 13px;
        font-weight: 700;
        color: #f2f4f8;
        vertical-alignment: center;
    }

    // 搜索框容器：常驻元素，search-open 时宽度从 0 滑出（滑动手感）。
    // 内部内容固定为 full-w 宽度，动画期间由 clip 裁切呈现“展开”效果，
    // 文本不会随宽度重排。
    Rectangle {
        x: 84px;
        y: 14px;
        width: PlaylistState.search-open ? self.full-w : 0px;
        height: 22px;
        property <length> full-w: min(parent.width - 240px, 220px);
        border-radius: self.height / 2;
        background: #ffffff12;
        border-width: 1px;
        border-color: search-input.has-focus && PlaylistState.search-open
            ? TransportState.theme-color.with-alpha(0.60) : transparent;
        clip: true;
        opacity: PlaylistState.search-open ? 1.0 : 0.0;
        animate width { duration: 200ms; easing: ease-out; }
        animate opacity { duration: 150ms; }
        animate border-color { duration: 120ms; }

        // 吞掉空白处的点击，避免触发底下的窗口拖动；声明在输入框之前。
        TouchArea { mouse-cursor: text; }

        // 内部固定宽内容（不随滑出动画重排）。
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.full-w;
            height: 100%;

            search-input := TextInput {
                // 左侧 26px 留给内嵌的搜索图标。
                x: 26px;
                width: parent.width - 26px
                    - (PlaylistState.search-text == "" ? 0px : 20px);
                height: 100%;
                text <=> PlaylistState.search-text;
                font-size: 12px;
                color: #f2f4f8;
                vertical-alignment: center;
                edited => { PlaylistState.search-edited(PlaylistState.search-text); }
                // 失焦自动收起并清除过滤（焦点被其他元素接管时触发）。
                changed has-focus => {
                    if (!self.has-focus && PlaylistState.search-open) {
                        root.collapse-search();
                    }
                }
                // 回车播放当前过滤结果的第一首。
                accepted => {
                    if (PlaylistState.playlist.length > 0) { PlaylistState.play-at(0); }
                }
            }

            // 占位提示。
            Text {
                visible: PlaylistState.search-text == "";
                x: 26px;
                width: parent.width - 40px;
                height: 100%;
                text: "搜索（正则）";
                font-size: 11px;
                color: #ffffff59;
                vertical-alignment: center;
            }

            // 小清除按钮（有输入时出现）。
            Rectangle {
                visible: PlaylistState.search-text != "";
                x: parent.width - 20px;
                y: (parent.height - 14px) / 2;
                width: 14px;
                height: 14px;
                border-radius: 7px;
                background: clr-ta.has-hover ? #ffffff2e : transparent;
                Text {
                    width: 100%;
                    height: 100%;
                    text: "×";
                    font-size: 11px;
                    color: #c6ccd6;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                clr-ta := TouchArea {
                    clicked => {
                        PlaylistState.search-text = "";
                        PlaylistState.search-edited("");
                        search-input.focus();
                    }
                    mouse-cursor: pointer;
                }
            }
        }
    }

    // 搜索开关图标：内嵌在搜索框左端。点击展开（滑出并聚焦），
    // 再次点击收起并清除过滤。
    IconButton {
        x: 84px;
        y: 16px;
        button-size: 18px;
        active: PlaylistState.search-open;
        source: @image-url("../icons/搜索.svg");
        clicked => {
            if (PlaylistState.search-open) {
                root.collapse-search();
            } else {
                PlaylistState.search-open = true;
                search-input.focus();
            }
        }
    }

    Text {
        x: parent.width - 134px;
        y: 15px;
        width: 44px;
        height: 20px;
        text: "清空";
        font-size: 12px;
        color: #9aa3b2;
        horizontal-alignment: center;
        vertical-alignment: center;
        TouchArea {
            clicked => { PlaylistState.clear-playlist(); }
            mouse-cursor: pointer;
        }
    }
    IconButton {
        x: parent.width - 46px;
        y: 13px;
        button-size: 24px;
        source: @image-url("../icons/关闭.svg");
        clicked => {
            root.collapse-search();
            root.close-requested();
        }
    }

    // 空列表 / 无匹配提示（垂直居中于列表区域）。
    Text {
        x: 0px;
        y: 42px + (parent.height - 48px - 40px) / 2;
        width: 100%;
        height: 40px;
        text: "列表为空 · 双击窗口或拖入音频文件添加";
        visible: PlaylistState.playlist.length == 0 && PlaylistState.search-text == "";
        font-size: 11px;
        color: #8b93a3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px;
        y: 42px + (parent.height - 48px - 40px) / 2;
        width: 100%;
        height: 40px;
        text: "没有匹配的歌曲（输入正则或普通文本）";
        visible: PlaylistState.playlist.length == 0 && PlaylistState.search-text != "";
        font-size: 11px;
        color: #8b93a3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    list-flick := Flickable {
        x: 8px;
        // 视口偏移暴露给全局：滚轮与自动滚动（覆盖层 / Rust）统一驱动。
        viewport-y <=> PlaylistState.list-vp-y;
        // 拖动排序中滚动（滚轮 / 边缘自动滚动）后，目标行跟随新的内容位置。
        changed viewport-y => {
            if (PlaylistState.reorder-from >= 0.0 && PlaylistState.reorder-to >= 0.0) {
                PlaylistState.reorder-to = clamp(
                    list-ta.content-row,
                    0.0,
                    PlaylistState.playlist.length * 1.0 - 1.0
                );
            }
        }
        y: 42px;
        width: parent.width - 16px;
        height: parent.height - 48px;
        viewport-height: PlaylistState.playlist.length * 32px + 2px;
        VerticalLayout {
            spacing: 2px;
            for entry[i] in PlaylistState.playlist: PlaylistRow {
                text: entry.name;
                index: i;
                real: entry.real;
                remove => { PlaylistState.remove-track(i); }
                open-folder => { PlaylistState.open-folder(i); }
            }
        }
    }

    // 拖动排序浮块：跟随系统光标纵向移动，代替被压暗的原行；
    // y 由 Rust 侧计时器按窗口局部坐标写入并钳制在列表区域内。
    // 底色与 Tooltip 同款：深色玻璃 + 主题色调叠加，避免纯黑生硬。
    Rectangle {
        visible: PlaylistState.reorder-from >= 0.0 && PlaylistState.reorder-text != "";
        x: 8px;
        y: clamp(PlaylistState.reorder-y * 1px - 15px, 46px, parent.height - 32px);
        width: parent.width - 16px;
        height: 30px;
        border-radius: 8px;
        background: #131823f2;
        border-width: 1px;
        border-color: TransportState.theme-color.with-alpha(0.6);
        drop-shadow-offset-y: 4px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000088;


        // 主题色调叠加层（淡）。
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            border-radius: 8px;
            background: TransportState.theme-color;
            opacity: 0.3;
        }

        Image {
            x: 10px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("../icons/拖动.svg");
            image-fit: contain;
            image-rendering: smooth;
            opacity: 0.9;
        }
        Text {
            x: 30px;
            width: parent.width - 44px;
            height: 100%;
            text: PlaylistState.reorder-text;
            color: #f2f4f8;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // 列表全区覆盖层：轻点执行行动作（播放/文件夹/删除），按住手柄图标
    // 并拖动进行排序（浮块出现前有一段待命位移，轻点歌曲不再弹出浮块）。
    // 放在 Flickable 之上且不属于它的子节点——列表不响应拖拽滚动
    // （滚动用滚轮或拖动到上下边缘自动滚动），无排序/滚动手势冲突。
    // 仅面板激活时可交互（抽屉=playlist-open，弹窗=常开）；
    // 文件夹/删除按钮由点击横坐标路由。
    list-ta := TouchArea {
        visible: root.active;
        x: 8px;
        y: 42px;
        width: parent.width - 16px;
        height: parent.height - 48px;
        property <length> press-mouse-y: 0px;
        // 按下的行是否落在手柄图标上（行首六点 grip，带少量容差）。
        property <bool> armed-handle: false;
        // 指针对应的列表内容行（浮点）；内容坐标 = 指针 y - 滚动偏移。
        property <float> content-row: Math.floor(
            (self.mouse-y - list-flick.viewport-y) / (30px + 2px)
        );
        property <bool> row-valid: (self.mouse-y - list-flick.viewport-y) >= 0px
            && content-row < PlaylistState.playlist.length * 1.0;
        // 行内右侧按钮的命中范围（行宽 = parent.width - 16px）。
        property <bool> in-folder-x: self.mouse-x >= parent.width - 70px
            && self.mouse-x <= parent.width - 56px;
        property <bool> in-delete-x: self.mouse-x >= parent.width - 48px
            && self.mouse-x <= parent.width - 34px;

        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                press-mouse-y = self.mouse-y;
                // 搜索过滤中行号与真实顺序不一致：禁用手柄起拖，仅保留点击。
                armed-handle = row-valid && PlaylistState.search-text == ""
                    && self.mouse-x >= 2px && self.mouse-x <= 25px;
                if row-valid {
                    // 待命：仅记录来源行，浮块等真正起拖后才出现。
                    PlaylistState.reorder-from = content-row;
                    PlaylistState.reorder-to = -1.0;
                }
            } else if e.kind == PointerEventKind.move {
                if armed-handle && PlaylistState.reorder-to < 0.0 {
                    // 位移超过阈值才真正起拖：填充浮块文本并标记起始目标。
                    if abs(self.mouse-y - press-mouse-y) > 8px {
                        PlaylistState.reorder-to = PlaylistState.reorder-from;
                        PlaylistState.set-reorder-text(PlaylistState.reorder-from);
                    }
                } else if PlaylistState.reorder-to >= 0.0 {
                    PlaylistState.reorder-to = clamp(
                        content-row,
                        0.0,
                        PlaylistState.playlist.length * 1.0 - 1.0
                    );
                } else {
                    PlaylistState.hover-row = row-valid ? content-row : -1.0;
                    PlaylistState.hover-button = row-valid
                        ? (in-folder-x ? 1.0 : (in-delete-x ? 2.0 : 0.0))
                        : 0.0;
                }
            } else if e.kind == PointerEventKind.up {
                if PlaylistState.reorder-from >= 0.0 {
                    if PlaylistState.reorder-to >= 0.0
                        && Math.abs(PlaylistState.reorder-to - PlaylistState.reorder-from) > 0.5
                    {
                        PlaylistState.move-track(PlaylistState.reorder-from, PlaylistState.reorder-to);
                    } else if Math.abs(self.mouse-y - press-mouse-y) < 8px {
                        // 轻点：按横坐标路由到行动作（删除 / 打开文件夹 / 播放）。
                        if in-delete-x {
                            PlaylistState.remove-track(PlaylistState.reorder-from);
                        } else if in-folder-x {
                            PlaylistState.open-folder(PlaylistState.reorder-from);
                        } else {
                            PlaylistState.play-at(PlaylistState.reorder-from);
                        }
                    }
                    PlaylistState.reorder-from = -1.0;
                    PlaylistState.reorder-to = -1.0;
                    PlaylistState.reorder-text = "";
                }
                armed-handle = false;
                // 搜索框打开时，在列表区的任何点击（播放/删除/空白处）
                // 都收起搜索框并恢复完整列表；行动作已在上方按过滤态结算。
                if PlaylistState.search-open { root.collapse-search(); }
            }
        }
        // 滚轮滚动列表（覆盖层是 Flickable 的兄弟节点，滚轮不会自然到达它，
        // 必须在此手动驱动视口；拖动排序中光标被捕获，同样由此处理）。
        scroll-event(e) => {
            PlaylistState.list-vp-y = clamp(
                PlaylistState.list-vp-y + e.delta_y,
                min(0px, (parent.height - 48px) - (PlaylistState.playlist.length * 32px + 2px)),
                0px
            );
            if (PlaylistState.reorder-from >= 0.0 && PlaylistState.reorder-to >= 0.0) {
                PlaylistState.reorder-to = clamp(
                    content-row,
                    0.0,
                    PlaylistState.playlist.length * 1.0 - 1.0
                );
            }
            accept
        }
        mouse-cursor: PlaylistState.reorder-to >= 0.0 ? grabbing : pointer;
    }

}

// 抽屉根：主窗口实例化。只负责开合动画外壳与“弹出为独立窗口”入口，
// 面板内容在 PlaylistPanel（弹窗复用同一面板）。
export component PlaylistDrawer inherits Rectangle {
    in property <length> closed-y;

    public function collapse-search() {
        panel.collapse-search();
    }

    // 播放列表抽屉：展开时覆盖整个窗口（窗口本来就不高，全覆盖能看到
    // 最多的行数，窗口缩小也不会把内容挤出屏外）。
    Rectangle {
        x: 0px;
        y: PlaylistState.playlist-open ? 0px : closed-y;
        width: parent.width;
        height: parent.height;
        // 收起时整体隐藏：closed-y 锚定在不含停靠区的基础高度上（停靠开合
        // 动画期间恒定，见 main.slint），展开/收拢动画照常，停靠动画不会
        // 把收起的抽屉带着滑过新展开区域（"点模块按钮播放列表弹出来又滑
        // 下去"的修复）；隐藏态不渲染，也省掉收起时的无谓绘制。
        visible: PlaylistState.playlist-open;
        // 缓入缓出（用户要求）：320ms ease-in-out 双向曲线，展开收拢都有
        // 惯性感；收起瞬间的 visible 隐藏保留（停靠开合期间防抽屉扫过）。
        animate y { duration: 320ms; easing: ease-in-out; }

        panel := PlaylistPanel {
            width: 100%;
            height: 100%;
            active: PlaylistState.playlist-open;
            docked: true;
            close-requested => { PlaylistState.toggle-playlist(); }
        }

        // 弹出为独立窗口（阶段 C 首落地）：仅抽屉形态提供入口。
        IconButton {
            x: parent.width - 78px;
            y: 16px;
            button-size: 18px;
            source: @image-url("../icons/弹出.svg");
            clicked => { PlaylistState.pop-out(); }
        }
    }

}
