// 均衡器面板（阶段 1 首个真实停靠模块）：10 段竖向滑条 ±12dB + 预设 + 开关。
// 排布采用经典 EQ 布局：顶行 = 开关 + 预设 + 量程提示，下方滑条整行铺开
// （旧版把滑条挤在右侧 1/4 宽度里，被用户指出"排版古怪"）。增益回写经
// EqState.set-gain 回调到 Rust 侧（引擎即时生效 + 持久化），面板不持音频状态。
import { EqState, TransportState } from "state.slint";

// 单个频段滑条：数值 / 滑槽（0dB 中线 + 双向填充 + 拇指）/ 频段标签。
component BandSlider inherits Rectangle {
    in property <int> band;
    in property <string> label;
    in property <float> gain; // -12 ~ +12 dB（Rust 侧已按 0.5dB 吸附）
    min-width: 36px;
    horizontal-stretch: 1;

    Text {
        y: 0px;
        width: parent.width;
        height: 14px;
        text: root.gain == 0.0 ? "0"
            : (root.gain > 0.0 ? "+" : "-")
            + (root.gain == root.gain.floor()
                ? round(abs(root.gain))
                : round(abs(root.gain) * 2.0) / 2.0);
        font-size: 10px;
        color: root.gain != 0.0 ? TransportState.theme-color : #9aa3b2;
        horizontal-alignment: center;
    }

    Rectangle {
        x: (parent.width - 4px) / 2;
        y: 16px;
        width: 4px;
        height: parent.height - 48px;
        border-radius: 2px;
        background: #ffffff14;
        // 0dB 中线刻度。
        Rectangle {
            y: parent.height / 2 - 1px;
            width: parent.width;
            height: 1px;
            background: #ffffff2e;
        }
        // 增益填充：从 0dB 中线向增益方向伸展。
        Rectangle {
            width: parent.width;
            height: min(parent.height / 2, abs(root.gain) * parent.height / 24.0);
            y: root.gain >= 0.0 ? parent.height / 2 - self.height : parent.height / 2;
            border-radius: 2px;
            background: TransportState.theme-color.with-alpha(0.75);
        }
        // 拇指。
        Rectangle {
            width: 18px;
            height: 10px;
            x: (parent.width - self.width) / 2;
            y: clamp(parent.height / 2 + root.gain * parent.height / 24.0
                - self.height / 2, 0px, parent.height - self.height);
            border-radius: 5px;
            background: #f2f4f8;
            border-width: 1px;
            border-color: #0f131b;
        }
    }

    ta := TouchArea {
        y: 16px;
        height: parent.height - 48px;
        // 只在按住时调值：down 跳值 + moved 拖动跟随。上一版在
        // pointer-event 里响应 move（悬停也触发），鼠标路过就改增益。
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                EqState.set-gain(root.band,
                    clamp((self.height / 2 - self.mouse-y) * 24.0 / self.height, -12.0, 12.0));
            }
        }
        moved => {
            EqState.set-gain(root.band,
                clamp((self.height / 2 - self.mouse-y) * 24.0 / self.height, -12.0, 12.0));
        }
        mouse-cursor: ns-resize;
    }

    Text {
        y: parent.height - 30px;
        width: parent.width;
        height: 14px;
        text: root.label;
        font-size: 10px;
        color: #9aa3b2;
        horizontal-alignment: center;
    }
    Text {
        y: parent.height - 16px;
        width: parent.width;
        height: 12px;
        text: "Hz";
        font-size: 8px;
        color: #ffffff38;
        horizontal-alignment: center;
    }
}

export component EqPanel inherits Rectangle {
    VerticalLayout {
        x: 12px;
        y: 6px;
        width: parent.width - 24px;
        height: parent.height - 12px;
        spacing: 8px;

        // 顶行：开关 + 预设 chips + 量程提示。
        HorizontalLayout {
            height: 26px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 96px;
                height: 26px;
                border-radius: 13px;
                border-width: 1px;
                border-color: EqState.enabled
                    ? TransportState.theme-color.with-alpha(0.55) : #ffffff1f;
                background: EqState.enabled
                    ? TransportState.theme-color.with-alpha(0.20) : #ffffff0a;
                animate background { duration: 120ms; }
                Text {
                    text: EqState.enabled ? "均衡器 开" : "均衡器 关";
                    font-size: 11px;
                    color: EqState.enabled ? #f2f4f8 : #9aa3b2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { EqState.toggle-enabled(); }
                    mouse-cursor: pointer;
                }
            }

            for preset[i] in EqState.preset-names: Rectangle {
                width: 48px;
                height: 26px;
                border-radius: 13px;
                border-width: 1px;
                border-color: EqState.active-preset == i + 1
                    ? TransportState.theme-color.with-alpha(0.55) : #ffffff1f;
                background: EqState.active-preset == i + 1
                    ? TransportState.theme-color.with-alpha(0.20) : #ffffff0a;
                animate background { duration: 120ms; }
                Text {
                    text: preset;
                    font-size: 11px;
                    color: EqState.active-preset == i + 1 ? #f2f4f8 : #9aa3b2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { EqState.apply-preset(i + 1); }
                    mouse-cursor: pointer;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                width: 160px;
                height: 26px;
                text: EqState.enabled ? "±12 dB · 0.5 dB 步进" : "已旁路（信号直通）";
                font-size: 10px;
                color: #ffffff59;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // 滑条整行（禁用态整列降透明度，直观呈现"旁路"）。
        HorizontalLayout {
            height: parent.height - 34px;
            spacing: 4px;
            opacity: EqState.enabled ? 1.0 : 0.45;
            animate opacity { duration: 150ms; }

            for g[i] in EqState.gains: BandSlider {
                band: i;
                gain: g;
                label: EqState.band-labels[i];
            }
        }
    }
}
